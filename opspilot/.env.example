# Copy to .env for local overrides. Never commit .env.
SERVICE_NAME=opspilot-api
ENVIRONMENT=local
LOG_LEVEL=INFO

# true = deterministic mock LLM + hashing embedder (no API key, no cost). It does NOT turn off
# Kafka or PostgreSQL. A real provider must be implemented first (see README).
MOCK_MODE=true

# Host-side connection strings for the Compose stack (containers use their own, see compose).
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# "kafka" (default) or "memory" (tests / running the API without a broker).
EVENT_BACKEND=kafka
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173"]

# Database for `pytest -m integration` (created automatically if missing).
TEST_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot_test
# Set to 1 (as CI does) to FAIL instead of skip when the test database is unreachable.
REQUIRE_DB_TESTS=0

# Copy to .env for local overrides. Never commit .env.
SERVICE_NAME=opspilot-api
ENVIRONMENT=local
LOG_LEVEL=INFO

# When true, no LLM provider or API key is needed (default for all demos/tests).
MOCK_MODE=true

# Used when running the API / Alembic on your host against the Compose Postgres.
# Inside Compose the host is `postgres` (set in infra/docker-compose.yml).
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot

# Database for `pytest -m integration` (created automatically if missing).
TEST_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot_test
# Set to 1 (e.g. in CI) to FAIL instead of skip when the test database is unreachable.
REQUIRE_DB_TESTS=0
